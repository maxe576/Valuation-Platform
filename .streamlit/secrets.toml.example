# Streamlit Community Cloud secrets template.
# In the Streamlit Cloud app dashboard: Settings → Secrets → paste these.
# Locally you can use a .env file instead (see .env.example).
# NEVER commit the real secrets.toml — it is gitignored.

APP_MODE = "live"
SEC_USER_AGENT = "Student Fund Research valuation-platform (you@example.com)"

# Optional convenience data sources
FMP_API_KEY = ""
FRED_API_KEY = ""

# AI provider (ollama is local-only and not reachable from Streamlit Cloud;
# use gemini in the cloud)
AI_PROVIDER = "gemini"
GEMINI_API_KEY = ""

# Supabase (persistence). Use the ANON key here — never the service-role key.
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
