# =====================================================================
# Valuation Platform — environment template
# Copy to .env and fill in. The app runs fully in DEMO mode with NONE
# of these set. Add keys only to enable live data / persistence.
# =====================================================================

# --- Run mode -------------------------------------------------------
# demo  = bundled fixture data, zero network calls (default)
# live  = use SEC EDGAR (+ optional FMP/FRED) for real data
APP_MODE=demo

# --- SEC EDGAR ------------------------------------------------------
# SEC requires a descriptive User-Agent with contact info. Free, no key.
SEC_USER_AGENT="Student Fund Research valuation-platform (wmaxe576@gmail.com)"

# --- Financial Modeling Prep (optional convenience source) ----------
FMP_API_KEY=

# --- FRED (optional macro data) -------------------------------------
FRED_API_KEY=

# --- AI provider (Phase 7) ------------------------------------------
# ollama (local, free, default) | gemini
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=

# --- Supabase (Phase 8) ---------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEVER put the service-role key in client code / browser env.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local database backend -----------------------------------------
# sqlite path used by the local repository until Supabase is wired.
LOCAL_DB_PATH=data/valuation_platform.sqlite
